---
import { Font } from "astro:assets";
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_SOCIAL_IMAGE,
  SITE_SOCIAL_IMAGE_ALT,
  SITE_SOCIAL_IMAGE_WIDTH,
  SITE_SOCIAL_IMAGE_HEIGHT,
} from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = SITE_SOCIAL_IMAGE,
  imageAlt,
  imageWidth = image === SITE_SOCIAL_IMAGE
    ? SITE_SOCIAL_IMAGE_WIDTH
    : undefined,
  imageHeight = image === SITE_SOCIAL_IMAGE
    ? SITE_SOCIAL_IMAGE_HEIGHT
    : undefined,
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const socialAlt =
  imageAlt ?? (image === SITE_SOCIAL_IMAGE ? SITE_SOCIAL_IMAGE_ALT : pageTitle);
const imageType = (
  {
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    png: "image/png",
    webp: "image/webp",
  } as Record<string, string>
)[socialImage.pathname.split(".").pop()?.toLowerCase() ?? ""];
const sitemap = new URL("sitemap-index.xml", Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-inter" preload />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href={sitemap} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE_LOCALE.replaceAll("-", "_")} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={socialAlt} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{
  imageHeight && (
    <meta property="og:image:height" content={String(imageHeight)} />
  )
}
{imageType && <meta property="og:image:type" content={imageType} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialAlt} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta name="generator" content={Astro.generator} />
