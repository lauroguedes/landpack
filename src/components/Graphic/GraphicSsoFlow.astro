---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <div class="sso-flow_wrap" data-step="idle">
      <div
        class="sso-flow_artboard"
        role="button"
        tabindex="0"
        aria-label="Play SSO flow: the user opens the login page, approves consent, returns to the application, and receives access."
      >
        <div class="sso-flow_provider">
          YOUR SSO <span>One trusted identity</span>
        </div>
        <svg
          class="sso-flow_paths"
          viewBox="0 0 100 64"
          fill="none"
          aria-hidden="true"
        >
          <path d="M14 39V15H38M47 15H68V39H86M86 45V52H14V45" />
          <path class="sso-flow_return" d="m17 50-3 2 3 2" />
        </svg>
        <div class="sso-flow_node user">
          <>
            <span class="sso-flow_symbol">◎</span>
            <strong>Your user</strong>
            <small>One account</small>
          </>
        </div>
        <div class="sso-flow_node login">
          <>
            <small>01</small>
            <strong>Login</strong>
            <span class="sso-flow_field" />
            <span class="sso-flow_field short" />
          </>
        </div>
        <div class="sso-flow_node consent">
          <>
            <small>02</small>
            <strong>Consent</strong>
            <span class="sso-flow_allow">✓ Allow access</span>
          </>
        </div>
        <div class="sso-flow_node app">
          <>
            <small>03</small>
            <strong>Your app</strong>
            <span class="sso-flow_app-status">Signed in</span>
          </>
        </div>
        <span class="sso-flow_signal" aria-hidden="true" />
        <span class="sso-flow_access">✓ Access granted</span>
      </div>
      <div class="sso-flow_caption">
        <span class="sso-flow_status">Hover or tap to follow the sign-in</span>
      </div>
    </div>
  )
}
<script>
  for (const flow of document.querySelectorAll<HTMLElement>(".sso-flow_wrap")) {
    const status = flow.querySelector<HTMLElement>(".sso-flow_status");
    const artboard = flow.querySelector<HTMLElement>(".sso-flow_artboard");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const messages = [
      "01 / Sign in on your SSO",
      "02 / Approve the requested access",
      "03 / Return securely to the app",
      "04 / You’re in. Access granted.",
    ];
    const steps = ["login", "consent", "app", "access"];
    let running = false;
    let timers: ReturnType<typeof setTimeout>[] = [];
    const setStep = (index: number) => {
      flow.dataset.step = steps[index];
      if (status) status.textContent = messages[index];
    };
    const finish = () => {
      timers.forEach(clearTimeout);
      timers = [];
      flow.classList.remove("playing");
      setStep(3);
      running = false;
    };
    const play = () => {
      if (running) return;
      if (reduced.matches) {
        finish();
        return;
      }
      running = true;
      flow.classList.add("playing");
      setStep(0);
      timers = [
        setTimeout(() => setStep(1), 2000),
        setTimeout(() => setStep(2), 4000),
        setTimeout(() => setStep(3), 6000),
        setTimeout(finish, 8000),
      ];
    };
    flow.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") play();
    });
    artboard?.addEventListener("click", play);
    artboard?.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        play();
      }
    });
    reduced.addEventListener("change", () => {
      if (reduced.matches && running) finish();
    });
  }
</script>
<style is:global>
  @layer components {
    .sso-flow_wrap {
      width: 100%;
      & .sso-flow_artboard {
        container-type: inline-size;
        position: relative;
        aspect-ratio: 100 / 59;
        isolation: isolate;
        cursor: pointer;
      }
      & .sso-flow_artboard:focus-visible {
        outline-offset: calc(var(--focus-offset) * -1);
        border-radius: 0.6rem;
      }
      & .sso-flow_paths {
        position: absolute;
        inset: 0;
        width: 100%;
        height: auto;
        stroke: var(--border);
        stroke-width: 0.25;
      }
      & .sso-flow_provider {
        position: absolute;
        left: 29cqw;
        top: 4cqw;
        font: 1.6cqw var(--font-code);
        letter-spacing: 0.12em;
        color: var(--brand-500);
      }
      & .sso-flow_provider span {
        margin-left: 2cqw;
        color: var(--text-2);
        letter-spacing: 0;
      }
      & .sso-flow_node {
        position: absolute;
        z-index: 2;
        width: 18cqw;
        height: 15cqw;
        padding: 2cqw;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.9cqw;
        border: var(--border-width) solid var(--border);
        border-radius: 2cqw;
        background: var(--background-2);
        transition:
          border-color 350ms ease,
          background 350ms ease,
          box-shadow 350ms ease;
      }
      & .sso-flow_node strong {
        font-size: 2.4cqw;
        font-weight: 500;
      }
      & .sso-flow_node small {
        font: 1.65cqw var(--font-code);
        color: var(--text-2);
      }
      & .sso-flow_node.user {
        left: 5cqw;
        top: 31.5cqw;
      }
      & .sso-flow_node.login {
        left: 29cqw;
        top: 9cqw;
      }
      & .sso-flow_node.consent {
        left: 59cqw;
        top: 9cqw;
      }
      & .sso-flow_node.app {
        left: 77cqw;
        top: 31.5cqw;
      }
      & .sso-flow_symbol {
        font-size: 3.3cqw;
        line-height: 1;
        color: var(--brand-500);
      }
      & .sso-flow_field {
        display: block;
        height: 0.6cqw;
        width: 100%;
        border-radius: 1cqw;
        background: var(--border);
      }
      & .sso-flow_field.short {
        width: 65%;
      }
      & .sso-flow_allow {
        font-size: 1.65cqw;
        color: var(--brand-500);
      }
      & .sso-flow_app-status {
        font-size: 1.65cqw;
        color: var(--brand-500);
        opacity: 0;
        transition: opacity 300ms ease;
      }
      & .sso-flow_signal {
        position: absolute;
        z-index: 1;
        left: 0;
        top: 0;
        transform: translate(14cqw, 39cqw);
        translate: -50% -50%;
        width: 1.25cqw;
        height: 1.25cqw;
        border-radius: 50%;
        background: var(--brand-500);
        box-shadow: 0 0 2cqw
          color-mix(in srgb, var(--brand-500) 45%, transparent);
        opacity: 0;
      }
      & .sso-flow_access {
        position: absolute;
        top: 50.5cqw;
        left: 35cqw;
        padding-inline: 2cqw;
        background: var(--background-2);
        font: 1.8cqw var(--font-code);
        color: var(--brand-500);
        opacity: 0;
        transition: opacity 300ms ease;
      }
      &.playing .sso-flow_signal {
        opacity: 1;
        animation: sso-journey 8s linear forwards;
      }
      &[data-step="login"] .login,
      &[data-step="consent"] .consent,
      &[data-step="app"] .app,
      &[data-step="access"] :is(.user, .app) {
        border-color: var(--brand-500);
        background: color-mix(
          in srgb,
          var(--brand-500) 9%,
          var(--background-2)
        );
        box-shadow: 0 0 4cqw
          color-mix(in srgb, var(--brand-500) 8%, transparent);
      }
      &[data-step="access"] .sso-flow_access,
      &[data-step="access"] .sso-flow_app-status,
      &[data-step="app"] .sso-flow_app-status {
        opacity: 1;
      }
      & .sso-flow_caption {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.75rem;
        padding: 0 1.25rem 1rem;
        color: var(--text-2);
        font-size: 0.625rem;
      }
      @media (prefers-reduced-motion: reduce) {
        & *,
        & .sso-flow_node {
          animation: none !important;
          transition: none !important;
        }
      }
    }
    @keyframes sso-journey {
      0% {
        transform: translate(14cqw, 39cqw);
      }
      12% {
        transform: translate(14cqw, 15cqw);
      }
      25% {
        transform: translate(38cqw, 15cqw);
      }
      45% {
        transform: translate(68cqw, 15cqw);
      }
      55% {
        transform: translate(68cqw, 39cqw);
      }
      65% {
        transform: translate(86cqw, 39cqw);
      }
      75% {
        transform: translate(86cqw, 52cqw);
      }
      92% {
        transform: translate(14cqw, 52cqw);
      }
      100% {
        transform: translate(14cqw, 39cqw);
      }
    }
  }
</style>
