---
import type { CollectionEntry } from "astro:content";
import BrowserFrame from "@/components/Media/BrowserFrame.astro";
import ThemeImage from "@/components/Media/ThemeImage.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Project content from the collection. */
  project: CollectionEntry<"project">["data"];
}
const { render = true, project } = Astro.props;
const { preview } = project;
---

{
  render && preview && (
    <figure class="project-preview_wrap">
      {preview.image ? (
        <BrowserFrame variant={preview.frame} address={preview.address}>
          <ThemeImage
            src={preview.image}
            light={preview.imageLight}
            alt={preview.imageAlt ?? preview.caption}
            class="project-preview_screenshot"
            eager
          />
        </BrowserFrame>
      ) : (
        <div
          class="project-preview_artboard"
          role="img"
          aria-label={preview.caption}
        >
          <div class="project-preview_window" aria-hidden="true">
            <div class="project-preview_browser">
              <span>● ● ●</span>
              <span class="project-preview_address">
                ♧ &nbsp; {preview.address}
              </span>
              <span>↗</span>
            </div>
            <div class="project-preview_body">
              <aside class="project-preview_sidebar">
                <strong class="project-preview_brand">
                  ⬡ &nbsp; {project.shortName}
                </strong>
                <span class="project-preview_workspace">WORKSPACE</span>
                <span>▦ &nbsp; Overview</span>
                <span class="project-preview_selected">
                  ▧ &nbsp; Applications <b>{preview.apps.length}</b>
                </span>
                <span>♙ &nbsp; Users</span>
                <span>◇ &nbsp; Roles & permissions</span>
                <span>◷ &nbsp; Sessions</span>
                <span>≋ &nbsp; Audit log</span>
                <div class="project-preview_bottom">
                  ⚙ &nbsp; Settings
                  <br />
                  <br />
                  LG &nbsp; Your workspace &nbsp; ⌄
                </div>
              </aside>
              <div class="project-preview_content">
                <div class="project-preview_breadcrumb">
                  Workspace <span>/</span> Applications{" "}
                  <span class="project-preview_secure">
                    ● &nbsp; All systems operational
                  </span>
                </div>
                <div class="project-preview_title">
                  <div>
                    <strong>{preview.title}</strong>
                    <p>{preview.subtitle}</p>
                  </div>
                  <span class="project-preview_add">
                    ＋ &nbsp; New application
                  </span>
                </div>
                <div class="project-preview_summary">
                  <div>
                    <span>Connected applications</span>
                    <strong>
                      0{preview.apps.length} <small>Ready to connect</small>
                    </strong>
                  </div>
                  <div>
                    <span>Authentication</span>
                    <strong>
                      OIDC <small>Standard protocol</small>
                    </strong>
                  </div>
                  <div>
                    <span>Your infrastructure</span>
                    <strong>
                      100% <small>Under your control</small>
                    </strong>
                  </div>
                </div>
                <div class="project-preview_table">
                  <div class="project-preview_row project-preview_tablehead">
                    <span>APPLICATION</span>
                    <span>PROTOCOL</span>
                    <span>STATUS</span>
                    <span>ACCESS</span>
                  </div>
                  {preview.apps.map((app, i) => (
                    <div class="project-preview_row">
                      <span class="project-preview_app">
                        <i>{["A", "C", "I"][i % 3]}</i>
                        <span>
                          <b>{app}</b>
                          <small>
                            {app.toLowerCase().replaceAll(" ", "-")}.example.com
                          </small>
                        </span>
                      </span>
                      <span>OpenID Connect</span>
                      <span class="project-preview_active">● Active</span>
                      <span>Manage &nbsp; ↗</span>
                    </div>
                  ))}
                </div>
                <div class="project-preview_note">
                  ♧ &nbsp; Credentials stay private. Your applications never see
                  a password.<span>View documentation ↗</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
      <figcaption class="project-preview_caption">
        <span class="project-preview_indicator" />
        {preview.caption}
      </figcaption>
    </figure>
  )
}
<style is:global>
  @layer components {
    .project-preview_wrap {
      width: 100%;
      max-width: 74rem;
      margin: 0 auto;
      & .project-preview_artboard {
        container-type: inline-size;
        aspect-ratio: 2.23;
        position: relative;
      }
      & .project-preview_window {
        position: absolute;
        inset: 0;
        overflow: hidden;
        border: var(--border-width) solid var(--border);
        border-radius: 0.85cqw;
        background: var(--background);
        box-shadow: 0 2cqw 6cqw -0.8cqw
          color-mix(in srgb, var(--text) 9%, transparent);
        font: 1.05cqw/1.5 var(--primary-family);
        text-align: left;
      }
      & .project-preview_browser {
        height: 3.7cqw;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: var(--border-width) solid var(--border);
        padding-inline: 1.6cqw;
        background: var(--background-2);
        color: var(--text-2);
      }
      & .project-preview_browser > :first-child {
        letter-spacing: 0.4cqw;
        font-size: 0.75cqw;
        opacity: 0.55;
      }
      & .project-preview_address {
        width: 34cqw;
        text-align: center;
        background: var(--background);
        border-radius: 0.35cqw;
        font-size: 0.9cqw;
        padding: 0.3cqw;
      }
      & .project-preview_body {
        display: flex;
        height: calc(100% - 3.7cqw);
      }
      & .project-preview_sidebar {
        width: 20cqw;
        padding: 2cqw 1.3cqw;
        border-right: var(--border-width) solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 1.1cqw;
        color: var(--text-2);
        background: var(--background-2);
      }
      & .project-preview_brand {
        font-size: 1.55cqw;
        color: var(--text);
        margin: 0 0.5cqw 1.8cqw;
        letter-spacing: -0.05cqw;
      }
      & .project-preview_workspace {
        font: 0.75cqw var(--font-code);
        letter-spacing: 0.1cqw;
      }
      & .project-preview_selected {
        padding: 0.65cqw;
        margin: -0.5cqw;
        background: color-mix(in srgb, var(--brand-500) 7%, var(--background));
        color: var(--brand-500);
        border-radius: 0.35cqw;
      }
      & .project-preview_selected b {
        float: right;
        font-weight: 400;
      }
      & .project-preview_bottom {
        margin-top: auto;
        font-size: 0.95cqw;
      }
      & .project-preview_content {
        padding: 2cqw 2.6cqw;
        flex: 1;
        min-width: 0;
      }
      & .project-preview_breadcrumb {
        font-size: 0.9cqw;
        display: flex;
        gap: 1cqw;
        color: var(--text-2);
      }
      & .project-preview_secure {
        margin-left: auto;
        font-size: 0.8cqw;
      }
      & .project-preview_title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 3cqw 0 2.3cqw;
      }
      & .project-preview_title strong {
        font-size: 2.3cqw;
        font-weight: 500;
        letter-spacing: -0.08cqw;
      }
      & .project-preview_title p {
        margin-top: 0.4cqw;
        color: var(--text-2);
        font-size: 0.95cqw;
      }
      & .project-preview_add {
        background: var(--text);
        color: var(--background);
        padding: 0.7cqw 1cqw;
        border-radius: 0.4cqw;
        font-size: 0.9cqw;
      }
      & .project-preview_summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border: var(--border-width) solid var(--border);
        border-radius: 0.5cqw;
        margin-bottom: 2.6cqw;
      }
      & .project-preview_summary > div {
        padding: 1.3cqw;
        border-right: var(--border-width) solid var(--border);
      }
      & .project-preview_summary > div:last-child {
        border: 0;
      }
      & .project-preview_summary span {
        font-size: 0.85cqw;
        color: var(--text-2);
      }
      & .project-preview_summary strong {
        display: flex;
        align-items: center;
        gap: 1cqw;
        font-size: 2cqw;
        font-weight: 500;
        margin-top: 0.5cqw;
      }
      & .project-preview_summary small {
        font-size: 0.65cqw;
        font-weight: 400;
        color: var(--text-2);
      }
      & .project-preview_row {
        display: grid;
        grid-template-columns: 2.2fr 1fr 0.7fr 0.7fr;
        align-items: center;
        padding: 1.2cqw 0.8cqw;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 0.9cqw;
      }
      & .project-preview_tablehead {
        background: var(--background-2);
        padding-block: 0.7cqw;
        font: 0.7cqw var(--font-code);
        color: var(--text-2);
      }
      & .project-preview_app {
        display: flex;
        gap: 0.9cqw;
        align-items: center;
      }
      & .project-preview_app i {
        width: 2.5cqw;
        height: 2.5cqw;
        display: grid;
        place-items: center;
        border: var(--border-width) solid var(--border);
        border-radius: 0.5cqw;
        font-size: 1.1cqw;
        font-style: normal;
        background: var(--background-2);
      }
      & .project-preview_app b {
        font-weight: 500;
      }
      & .project-preview_app small {
        display: block;
        color: var(--text-2);
        font-size: 0.75cqw;
        margin-top: 0.15cqw;
      }
      & .project-preview_active {
        font-size: 0.8cqw;
      }
      & .project-preview_note {
        display: flex;
        justify-content: space-between;
        margin-top: 1.6cqw;
        font-size: 0.73cqw;
        color: var(--text-2);
      }
      & .project-preview_caption {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
        margin-top: 1.5rem;
        font: 0.6875rem/1.5 var(--font-code);
        color: var(--text-2);
      }
      & .project-preview_indicator {
        width: 0.3rem;
        height: 0.3rem;
        border-radius: 50%;
        background: var(--brand-500);
      }
    }
  }
</style>
