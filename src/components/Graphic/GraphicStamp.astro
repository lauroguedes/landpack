---
import Button from "@/components/Button.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Text around the edge of the stamp. */
  ringText: string;
  /** Short title at the centre of the stamp. */
  title: string;
  /** Accessible description of the link. */
  label: string;
  /** Where the stamp links. */
  href: string;
}
const { render = true, ringText, title, label, href } = Astro.props;
const circleId = `stamp-${crypto.randomUUID()}`;
---

{
  render && ringText && title && href && (
    <div class="stamp_wrap">
      <Button
        element="link"
        href={href}
        class="stamp_link"
        aria-label={label}
        title={label}
      >
        <svg class="stamp_ring" viewBox="0 0 140 140" aria-hidden="true">
          <defs>
            <path
              id={circleId}
              d="M70,70 m-51,0 a51,51 0 1,1 102,0 a51,51 0 1,1 -102,0"
            />
          </defs>
          <circle cx="70" cy="70" r="67" />
          <circle cx="70" cy="70" r="37" />
          <text
            font-size="8.5"
            font-family="monospace"
            textLength="313"
            lengthAdjust="spacing"
          >
            <textPath href={`#${circleId}`} startOffset="0%">
              {ringText}
            </textPath>
          </text>
        </svg>
        <span class="stamp_center" aria-hidden="true">
          <>
            <span>✦</span>
            <strong>{title}</strong>
            <span class="button_arrow up-right">↗</span>
          </>
        </span>
      </Button>
    </div>
  )
}
<style is:global>
  @layer components {
    .stamp_wrap {
      width: 7.5rem;
      aspect-ratio: 1;
      & .stamp_link {
        --button-background: transparent;
        --button-background-hover: transparent;
        --button-text: var(--brand-500);
        --button-text-hover: var(--brand-500);
        --button-border-hover: transparent;
        display: block;
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--brand-500);
        opacity: 0.65;
        transform: rotate(10deg);
        transition:
          transform 450ms ease,
          opacity 450ms ease;
      }
      & .stamp_link:is(:hover, :focus-visible) {
        transform: rotate(0);
        opacity: 1;
      }
      & .stamp_ring {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      & .stamp_ring circle {
        fill: none;
        stroke: currentColor;
        stroke-width: 0.65;
        opacity: 0.45;
      }
      & .stamp_ring text {
        fill: currentColor;
        letter-spacing: 0.1em;
      }
      & .stamp_center {
        position: absolute;
        inset: 25%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
      }
      & .stamp_center strong {
        font: 0.65rem/1.2 var(--font-code);
        font-weight: 500;
        text-transform: uppercase;
      }
      & .stamp_center > span {
        font-size: 0.75rem;
      }
      & .stamp_link:is(:hover, :focus-visible) .button_arrow {
        transform: none;
      }
      & .button_arrow {
        margin: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        & .stamp_link {
          transition: none;
          transform: none;
        }
      }
    }
  }
</style>
