---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Classes for this element. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
---

{
  render && (
    <svg
      class:list={["project-mark", className]}
      viewBox="0 0 40 42"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M20 1.2 3.6 7.4A2 2 0 0 0 2.3 9.3v11.9c0 8.6 5.2 15.4 17 20.5.4.2.9.2 1.4 0 11.8-5.1 17-11.9 17-20.5V9.3a2 2 0 0 0-1.3-1.9L20 1.2Zm0 4.3 13.7 5.2v10.5c0 6.7-3.9 12-13.7 16.4C10.2 33.2 6.3 27.9 6.3 21.2V10.7L20 5.5Zm0 6.6a5.5 5.5 0 0 0-2.7 10.3l-1.8 8.2a1 1 0 0 0 1 1.2h7a1 1 0 0 0 1-1.2l-1.8-8.2A5.5 5.5 0 0 0 20 12.1Zm0 3.6a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8Z"
      />
    </svg>
  )
}
<style is:global>
  @layer components {
    .project-mark {
      width: 2rem;
      height: 2rem;
      color: var(--brand-500);
      flex-shrink: 0;
    }
  }
</style>
