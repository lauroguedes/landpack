---
interface Props {
  /** Set to false to hide the mark. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <svg
      class="star_wrap"
      viewBox="0 0 24 24"
      fill="currentColor"
      stroke="none"
      stroke-width="1.6"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" />
    </svg>
  )
}
<style is:global>
  @layer components {
    .star_wrap {
      display: inline-block;
      vertical-align: -0.25em;
      margin-right: 0.3em;
      width: 1rem;
      height: 1rem;
      flex: none;
      color: #b17a00;
      fill: currentColor;
    }
    .theme-dark .star_wrap {
      color: #f5cb59;
    }
  }
</style>
