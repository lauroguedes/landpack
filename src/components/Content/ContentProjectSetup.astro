---
import type { CollectionEntry } from "astro:content";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ContentCommand from "./ContentCommand.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The section heading. */
  heading: string;
  /** Supporting text below the heading. */
  description: string;
  /** Setup entries from the collection. */
  steps: CollectionEntry<"steps">[];
  /** Additional setup guidance. */
  note: string;
  /** Show the link to the integrations section when it exists. */
  hasIntegrations?: boolean;
}
const {
  render = true,
  heading,
  description,
  steps,
  note,
  hasIntegrations = true,
} = Astro.props;
---

<ContentWrapper
  render={render && steps.length > 0}
  variant="sticky-content"
  class="project-setup_wrap"
>
  <span class="project-setup_label">GET STARTED</span>
  <Heading variant="h2">{heading}</Heading>
  <Paragraph class="project-setup_intro">{description}</Paragraph>
  <Button
    render={hasIntegrations}
    element="link"
    variant="link"
    arrow="up-right"
    href="#connect"
    class="project-setup_link">Then connect your first app</Button
  >
  <Fragment slot="column2">
    <>
      <ol class="project-setup_steps">
        {
          steps.map(({ data: step }, i) => (
            <li class="project-setup_item">
              <div class="project-setup_title">
                <span>{String(i + 1).padStart(2, "0")}</span>
                <Heading tag="h3" variant="h6">
                  {step.title}
                </Heading>
              </div>
              <Paragraph variant="small">{step.description}</Paragraph>
              <ContentCommand command={step.command} />
            </li>
          ))
        }
      </ol>
      <Paragraph variant="small" class="project-setup_note">
        {note}
      </Paragraph>
    </>
  </Fragment>
</ContentWrapper>
<style is:global>
  @layer components {
    .project-setup_wrap.layout.sticky-content {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      & > * {
        min-width: 0;
      }
      gap: 5rem;
      & .project-setup_label {
        font: 0.65rem var(--font-code);
        letter-spacing: 0.12em;
        color: var(--brand-500);
      }
      & .heading {
        max-width: 12ch;
        margin-top: 1.2rem;
      }
      & .project-setup_intro {
        color: var(--text-2);
        max-width: 31ch;
      }
      & .project-setup_link {
        font-size: 0.8125rem;
        margin-top: 2rem;
      }
      & .project-setup_steps {
        list-style: none;
        padding: 0;
        width: 100%;
      }
      & .project-setup_item {
        padding-bottom: 2.3rem;
      }
      & .project-setup_title {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }
      &
        .project-setup_item:is(:hover, :focus-within)
        .project-setup_title
        > span {
        color: var(--brand-500);
        border-color: var(--brand-500);
        background: color-mix(in srgb, var(--brand-500) 15%, transparent);
        box-shadow: 0 0 1rem
          color-mix(in srgb, var(--brand-500) 25%, transparent);
      }
      & .project-setup_title > span {
        transition:
          color 300ms ease,
          border-color 300ms ease,
          background 300ms ease,
          box-shadow 300ms ease;
        font: 0.65rem var(--font-code);
        border: var(--border-width) solid var(--border);
        border-radius: 50%;
        padding: 0.5rem;
      }
      & .project-setup_title .heading {
        margin: 0;
        max-width: none;
        font-size: 1rem;
      }
      & .project-setup_item .text {
        margin-block: 0.8rem 1rem;
        color: var(--text-2);
        font-size: 0.8125rem;
      }
      & .project-setup_note {
        color: var(--text-2);
        border-top: var(--border-width) solid var(--border);
        padding-top: 1.5rem;
        margin: 0;
        font-size: 0.8rem;
      }
      @media (width < 64rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
      }
    }
  }
</style>
