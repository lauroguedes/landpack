---
import Button from "@/components/Button.astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Project facts from the collection. */
  stats: CollectionEntry<"project">["data"]["stats"];
}
const { render = true, stats } = Astro.props;
---

{
  render && stats.length > 0 && (
    <dl class="project-stats_wrap">
      {stats.map((stat) => (
        <div class="project-stats_item">
          <dt>{stat.label}</dt>
          <dd>
            {stat.href ? (
              <Button
                element="link"
                variant="link"
                arrow="up-right"
                href={stat.href}
                class="project-stats_link"
              >
                {stat.value}
              </Button>
            ) : (
              stat.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}
<style is:global>
  @layer components {
    .project-stats_wrap {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      width: 100%;
      border-block: var(--border-width) solid var(--border);
      padding-block: 2rem;
      & .project-stats_item {
        display: flex;
        flex-direction: column-reverse;
        gap: 0.6rem;
        padding-inline: 2rem;
        border-right: var(--border-width) solid var(--border);
      }
      & .project-stats_item:first-child {
        padding-left: 0;
      }
      & .project-stats_item:last-child {
        border-right: 0;
      }
      & dt {
        color: var(--text-2);
        font-size: 0.75rem;
      }
      & dd {
        font-size: 1.3rem;
        letter-spacing: -0.04em;
      }
      & .project-stats_link .button_arrow {
        font-size: 0.8rem;
        color: var(--text-2);
      }
      @media (width < 48rem) {
        grid-template-columns: 1fr 1fr;
        gap: 2rem 0;
        & .project-stats_item {
          padding-inline: 1rem;
        }
        & .project-stats_item:nth-child(odd) {
          padding-left: 0;
        }
        & .project-stats_item:nth-child(even) {
          border: 0;
        }
        & dd {
          font-size: 1.1rem;
        }
      }
    }
  }
</style>
