---
import type { CollectionEntry } from "astro:content";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The section heading. */
  heading: string;
  /** Supporting text below the heading. */
  description: string;
  /** Feature entries from the collection. */
  features: CollectionEntry<"features">[];
}
const { render = true, heading, description, features } = Astro.props;
const paths = {
  key: "M8 15a5 5 0 1 1 4-8l9 0v4h-3v3h-4l-2-2M7 9h.01",
  globe:
    "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c-5 5-5 13 0 18 5-5 5-13 0-18Z",
  apps: "M3 3h7v7H3ZM14 3h7v7h-7ZM3 14h7v7H3ZM14 14h7v7h-7Z",
  shield: "m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Zm-4 9 3 3 5-6",
  users:
    "M15 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM5 21v-3a7 7 0 0 1 14 0v3M19 4a3 3 0 0 1 0 6M21 14a5 5 0 0 1 2 4",
  code: "m8 5-6 7 6 7M16 5l6 7-6 7M14 3l-4 18",
  activity: "M2 12h5l3-8 4 16 3-8h5",
  palette:
    "M12 3a9 9 0 1 0 0 18c4 0 0-5 3-5h3c5 0 4-13-6-13ZM7 9h.01M11 6h.01M16 7h.01M18 11h.01",
  book: "M12 5v16M12 5C8 2 4 3 2 4v15c4-1 7 0 10 2 3-2 6-3 10-2V4c-2-1-6-2-10 1Z",
};
---

{
  render && features.length > 0 && (
    <div class="project-features_wrap">
      <ContentWrapper>
        <>
          <span class="project-features_label">THE TOOLKIT</span>
          <Heading variant="h2" class="project-features_heading">
            {heading}
          </Heading>
          <Paragraph class="project-features_intro" maxWidth={55}>
            {description}
          </Paragraph>
        </>
      </ContentWrapper>
      <Grid class="project-features_list">
        {features.map(({ data: feature }) => (
          <article class="project-features_item">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={paths[feature.icon]} />
            </svg>
            <Heading tag="h3" variant="h6">
              {feature.title}
            </Heading>
            <Paragraph variant="small">{feature.description}</Paragraph>
          </article>
        ))}
      </Grid>
    </div>
  )
}
<style is:global>
  @layer components {
    .project-features_wrap {
      width: 100%;
      & .project-features_label {
        font: 0.65rem var(--font-code);
        letter-spacing: 0.12em;
        color: var(--brand-500);
      }
      & .project-features_heading {
        white-space: pre-line;
        max-width: 22ch;
        margin-top: 1.2rem;
      }
      & .project-features_intro {
        color: var(--text-2);
      }
      & .project-features_list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 3rem;
        gap: 0 3.5rem;
      }
      & .project-features_item {
        padding-block: 2rem;
        border-top: var(--border-width) solid var(--border);
      }
      & .project-features_item svg {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--brand-500);
        margin-bottom: 1.3rem;
      }
      & .project-features_item .heading {
        margin: 0 0 0.75rem;
        font-size: 1rem;
      }
      & .project-features_item .text {
        color: var(--text-2);
        font-size: 0.85rem;
        margin: 0;
        max-width: 34ch;
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        & .project-features_item svg {
          transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
          transform-origin: center;
        }
        & .project-features_item:hover svg {
          transform: translateY(-0.3rem) rotate(-8deg) scale(1.12);
        }
        & .project-features_item:nth-child(even):hover svg {
          transform: translateY(-0.3rem) rotate(8deg) scale(1.12);
        }
      }
      @media (width < 48rem) {
        & .project-features_list {
          grid-template-columns: 1fr;
          gap: 0;
          margin-top: 1.5rem;
        }
        & .project-features_item {
          padding-block: 1.5rem;
        }
      }
    }
  }
</style>
