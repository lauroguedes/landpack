---
import { render as renderEntry, type CollectionEntry } from "astro:content";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Heading from "@/components/Typography/Heading.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import RichText from "@/components/Typography/RichText.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Frequently asked questions from the collection. */
  entries: CollectionEntry<"faq">[];
  /** Section title from project content. */
  heading: string;
  /** Supporting introduction. */
  description: string;
}
const { render = true, entries, heading, description } = Astro.props;
const questions = render
  ? await Promise.all(
      entries.map(async (entry) => ({
        ...entry,
        ...(await renderEntry(entry)),
      })),
    )
  : [];
---

{
  render && questions.length > 0 && (
    <div class="project-faq_wrap">
      <>
        <div class="project-faq_intro">
          <>
            <Heading variant="h3">{heading}</Heading>
            <Paragraph>{description}</Paragraph>
          </>
        </div>
        <div class="project-faq_list">
          {questions.map(({ data, Content }) => (
            <AccordionItem heading={data.question}>
              <RichText>
                <Content />
              </RichText>
            </AccordionItem>
          ))}
        </div>
      </>
    </div>
  )
}
<style is:global>
  @layer components {
    .project-faq_wrap {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
      width: 100%;
      & .project-faq_intro .heading {
        max-width: 14ch;
        margin: 0;
        font-size: 2.1rem;
      }
      & .project-faq_intro .text {
        max-width: 30ch;
        margin-top: 1.2rem;
        color: var(--text-2);
        font-size: 0.9rem;
      }
      & .accordion_title {
        font-size: 0.95rem;
      }
      & .accordion_body {
        color: var(--text-2);
        font-size: 0.85rem;
      }
      @media (width < 64rem) {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
  }
</style>
