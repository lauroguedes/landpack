---
import type { CollectionEntry } from "astro:content";
import { Code } from "astro:components";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Tabs from "@/components/Interactive/Tabs.astro";
import Icon from "@/components/Media/Icon.astro";
import laravel from "@/assets/icons/brands/laravel.svg";
import nodejs from "@/assets/icons/brands/nodejs.svg";
import python from "@/assets/icons/brands/python.svg";
import go from "@/assets/icons/brands/go.svg";
import openid from "@/assets/icons/brands/openid.svg";
const brandIcons = { laravel, nodejs, python, go, openid };
import TabLink from "@/components/Interactive/TabLink.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The section heading. */
  heading: string;
  /** Supporting text below the heading. */
  description: string;
  /** Integration entries from the collection. */
  integrations: CollectionEntry<"integrations">[];
}
const { render = true, heading, description, integrations } = Astro.props;
---

{
  render && integrations.length > 0 && (
    <div class="project-integrations_wrap">
      <>
        <ContentWrapper centered>
          <>
            <span class="project-integrations_label">SPEAKS YOUR LANGUAGE</span>
            <Heading variant="h2">{heading}</Heading>
            <Paragraph maxWidth={63}>{description}</Paragraph>
          </>
        </ContentWrapper>
        <Tabs variant="side" class="project-integrations_tabs">
          <Fragment slot="links">
            {integrations.map(({ data }) => (
              <TabLink data-tab-label={data.title}>
                <Icon
                  src={brandIcons[data.icon ?? "openid"]}
                  class="project-integrations_icon"
                />
                {data.title}
              </TabLink>
            ))}
          </Fragment>
          {integrations.map(({ data }) => (
            <div class="project-integrations_panel">
              <div class="project-integrations_bar">
                <span>{data.title}</span>
                <span>CLIENT SETUP</span>
              </div>
              <Code
                code={data.code}
                lang={data.language}
                themes={{ light: "github-light", dark: "github-dark" }}
                defaultColor={false}
                wrap
              />
              <div class="project-integrations_note">
                <Paragraph variant="small">{data.description}</Paragraph>
                {data.package && (
                  <span class="project-integrations_package">
                    {data.package}
                  </span>
                )}
                {data.source && data.source !== data.href && (
                  <Button
                    element="link"
                    variant="link"
                    arrow="up-right"
                    href={data.source}
                    class="project-integrations_link"
                  >
                    Library example
                  </Button>
                )}
                <Button
                  element="link"
                  variant="link"
                  arrow="up-right"
                  href={data.href}
                  class="project-integrations_link"
                >
                  Integration guide
                </Button>
              </div>
            </div>
          ))}
        </Tabs>
      </>
    </div>
  )
}
<style is:global>
  @layer components {
    .project-integrations_wrap {
      width: 100%;
      & .project-integrations_label {
        font: 0.65rem var(--font-code);
        letter-spacing: 0.12em;
        color: var(--brand-500);
      }
      & .layout .heading {
        margin-top: 1.2rem;
      }
      & .layout .text {
        color: var(--text-2);
        font-size: 0.95rem;
      }
      & .project-integrations_tabs.tabs_wrap.side {
        margin-top: 3rem;
        grid-template-columns: 13rem minmax(0, 1fr);
        gap: 3rem;
      }
      & .project-integrations_tabs.side .tabs_bar {
        border: 0;
      }
      & .project-integrations_tabs.side .tabs_links {
        gap: 0.35rem;
      }
      & .project-integrations_tabs.side .tabs_link {
        border: var(--border-width) solid transparent;
        padding: 1.1rem;
        border-radius: 0.4rem;
        width: 100%;
        font-size: 0.85rem;
      }
      & .project-integrations_tabs.side .tabs_link_text {
        display: flex;
        justify-content: start;
        align-items: center;
        width: 100%;
        gap: 0.8rem;
      }
      & .project-integrations_tabs.side .tabs_link[aria-selected="true"] {
        border-color: var(--border);
        color: var(--brand-500);
        background: var(--background-2);
      }
      & .project-integrations_tabs.side .tabs_link::after {
        display: none;
      }
      & .project-integrations_icon {
        width: 1.6rem;
        height: 1.6rem;
        color: var(--brand-500);
      }
      & .project-integrations_icon,
      & .project-integrations_icon :is(path, polygon, rect, circle, ellipse) {
        fill: currentColor;
      }
      & .project-integrations_panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--code-background);
        border-radius: 0.7rem;
        overflow: hidden;
        border: var(--border-width) solid var(--border);
      }
      & .project-integrations_bar {
        display: flex;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        background: var(--code-background);
        color: var(--code-text);
        border-bottom: var(--border-width) solid
          color-mix(in srgb, var(--code-text) 15%, transparent);
        font: 0.7rem var(--font-code);
      }
      & .project-integrations_bar > :last-child {
        opacity: 0.6;
        font-size: 0.6rem;
        letter-spacing: 0.08em;
      }
      & .astro-code,
      & .astro-code span {
        color: var(--shiki-light) !important;
      }
      .theme-dark & :is(.astro-code, .astro-code span) {
        color: var(--shiki-dark) !important;
      }
      & .astro-code {
        flex: 1;
        padding: 1.5rem;
        min-height: 14rem;
        max-height: 22rem;
        overflow: auto;
        font: 0.8rem/1.8 var(--font-code);
        background: var(--code-background) !important;
      }
      & .project-integrations_note {
        margin-top: auto;
        padding: 1.3rem 1.5rem;
        background: var(--background-2);
      }
      & .project-integrations_note .text {
        font-size: 0.75rem;
        color: var(--text-2);
        margin: 0 0 0.6rem;
      }
      & .project-integrations_package {
        display: block;
        font: 0.65rem var(--font-code);
        color: var(--text-2);
        margin-bottom: 0.8rem;
      }
      & .project-integrations_link {
        margin-right: 1.2rem;
        font-size: 0.75rem;
      }
      @media (width < 48rem) {
        & .project-integrations_tabs.tabs_wrap.side {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        & .project-integrations_tabs.side .tabs_links {
          flex-direction: row;
          flex-wrap: wrap;
        }
        & .project-integrations_tabs.side .tabs_link {
          width: auto;
          padding: 0.7rem;
        }

        & .astro-code {
          font-size: 0.6875rem;
          padding: 1rem;
        }
      }
    }
  }
</style>
