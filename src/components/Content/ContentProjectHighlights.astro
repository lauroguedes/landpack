---
import GraphicSsoFlow from "@/components/Graphic/GraphicSsoFlow.astro";
import BrowserFrame from "@/components/Media/BrowserFrame.astro";
import ThemeImage from "@/components/Media/ThemeImage.astro";
import type { CollectionEntry } from "astro:content";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Feature highlights from the collection. */
  highlights: CollectionEntry<"project">["data"]["highlights"];
}
const { render = true, highlights } = Astro.props;
---

{
  render && highlights.length > 0 && (
    <div class="project-highlights_wrap">
      {highlights.map((item, i) => (
        <ContentWrapper
          variant="columns"
          reverse={i % 2 === 1}
          class="project-highlights_row"
        >
          <span class="project-highlights_label">{item.eyebrow}</span>
          <Heading variant="h3">{item.title}</Heading>
          <Paragraph>{item.description}</Paragraph>
          <div
            slot="column2"
            class:list={[
              "project-highlights_visual",
              item.image && "screenshot",
              item.graphic === "flow" && "flow",
            ]}
            role={item.image || item.graphic === "flow" ? undefined : "img"}
            aria-label={
              item.image || item.graphic === "flow"
                ? undefined
                : "Application roles are isolated: one application’s permissions are not shared with another."
            }
          >
            {item.image ? (
              <BrowserFrame>
                <ThemeImage
                  src={item.image}
                  light={item.imageLight}
                  crop={item.crop}
                  cropLight={item.cropLight}
                  alt={item.imageAlt ?? item.description}
                  class="project-highlights_screenshot"
                />
              </BrowserFrame>
            ) : item.graphic === "flow" ? (
              <GraphicSsoFlow />
            ) : (
              <div class="project-highlights_roles">
                <div class="project-highlights_rolehead">
                  <span>Application permissions</span>
                  <span>♧ &nbsp; Isolated</span>
                </div>
                <div>
                  <span>ACME DASHBOARD</span>
                  <span>ROLE</span>
                </div>
                <div>
                  <span>Alex Morgan</span>
                  <b>Administrator</b>
                </div>
                <div>
                  <span>Jamie Chen</span>
                  <b>Developer</b>
                </div>
                <div>
                  <span>Sam Rivera</span>
                  <b>Member</b>
                </div>
                <footer>
                  ✓ &nbsp; Only this application’s roles appear in its tokens.
                </footer>
              </div>
            )}
          </div>
        </ContentWrapper>
      ))}
    </div>
  )
}
<style is:global>
  @layer components {
    .project-highlights_wrap {
      width: 100%;
      & .project-highlights_row {
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        padding-block: 3rem;
      }
      & .project-highlights_row:first-child {
        padding-top: 0;
      }
      & .project-highlights_row:last-child {
        padding-bottom: 0;
      }
      & .project-highlights_label {
        font: 0.625rem var(--font-code);
        letter-spacing: 0.1em;
        color: var(--brand-500);
      }
      & .heading {
        white-space: pre-line;
        margin-top: 1.2rem;
        font-size: clamp(2rem, 3.5vw, 3rem);
        line-height: 1.13;
      }
      & .text {
        color: var(--text-2);
        font-size: 0.9rem;
        max-width: 43ch;
      }
      & .project-highlights_visual {
        width: 100%;
        aspect-ratio: 1.65;
        background: var(--background-2);
        display: flex;
        justify-content: center;
        border-radius: 0.6rem;
        border: var(--border-width) solid var(--border);
        overflow: hidden;
        container-type: inline-size;
      }
      & .project-highlights_visual.flow {
        aspect-ratio: auto;
      }
      & .project-highlights_visual.screenshot {
        aspect-ratio: auto;
        border: 0;
        background: transparent;
        overflow: visible;
      }
      & .project-highlights_screenshot {
        width: 100%;
        height: auto;
        border-radius: 0.7rem;
      }
      & .project-highlights_visual svg {
        width: 100%;
      }
      & .project-highlights_roles {
        width: 85cqw;
        margin: auto;
        background: var(--background);
        border: var(--border-width) solid var(--border);
        border-radius: 1.2cqw;
        padding: 2.5cqw;
        font-size: 2.25cqw;
        box-shadow: 0 2cqw 5cqw color-mix(in srgb, var(--text) 4%, transparent);
      }
      & .project-highlights_roles > div {
        display: flex;
        justify-content: space-between;
        padding: 2.5cqw 1cqw;
        border-bottom: var(--border-width) solid var(--border);
      }
      & .project-highlights_roles > div:nth-child(2) {
        font: 1.8cqw var(--font-code);
        color: var(--text-2);
      }
      & .project-highlights_rolehead {
        font-weight: 500;
      }
      & .project-highlights_rolehead > :last-child {
        color: var(--text-2);
        font-weight: 400;
        font-size: 2cqw;
      }
      & .project-highlights_roles b {
        font-size: 1.8cqw;
        font-weight: 400;
        padding: 0.3cqw 1.5cqw;
        border: var(--border-width) solid var(--border);
        border-radius: 0.8cqw;
      }
      & .project-highlights_roles footer {
        font-size: 1.75cqw;
        color: var(--text-2);
        padding: 2.5cqw 1cqw 0;
      }
      @media (width < 64rem) {
        & .project-highlights_row {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }
    }
  }
</style>
