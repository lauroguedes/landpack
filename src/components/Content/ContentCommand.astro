---
import { Code } from "astro:components";
import Button from "@/components/Button.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The command copied to the clipboard. */
  command: string;
}
const { render = true, command } = Astro.props;
---

{
  render && command && (
    <div class="command_wrap">
      <span class="command_prompt" aria-hidden="true">
        $
      </span>
      <Code
        code={command}
        lang="bash"
        theme="css-variables"
        class="command_source"
        tabindex="0"
        aria-label="Installation command"
      />
      <Button
        emphasis="secondary"
        class="command_copy"
        data-copy-command={command}
        aria-label="Copy command"
      >
        <>
          <svg
            class="command_icon command_copy-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <>
              <rect x="8" y="8" width="12" height="12" rx="2" />
              <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
            </>
          </svg>
          <svg
            class="command_icon command_check-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12 4 4L19 6" />
          </svg>
        </>
      </Button>
      <span class="command_status sr-only" role="status" aria-live="polite" />
    </div>
  )
}
<noscript
  ><style>
    .command_copy {
      display: none;
    }
  </style></noscript
>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-command]")
    .forEach((button) => {
      let timer: ReturnType<typeof setTimeout>;
      button.addEventListener("click", async () => {
        const status =
          button.parentElement?.querySelector<HTMLElement>(".command_status");

        try {
          await navigator.clipboard.writeText(button.dataset.copyCommand ?? "");
          button.classList.add("copied");
          button.setAttribute("aria-label", "Command copied");
          if (status) status.textContent = "Command copied to clipboard.";
        } catch {
          button.classList.remove("copied");
          button.setAttribute(
            "aria-label",
            "Clipboard unavailable. Select and copy the command manually.",
          );
          const source = button.parentElement?.querySelector("code");
          if (source) {
            const range = document.createRange();
            range.selectNodeContents(source);
            window.getSelection()?.removeAllRanges();
            window.getSelection()?.addRange(range);
          }
          if (status)
            status.textContent =
              "Clipboard unavailable. Select and copy the command manually.";
        }
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.classList.remove("copied");
          button.setAttribute("aria-label", "Copy command");
          if (status) status.textContent = "";
        }, 2200);
      });
    });
</script>
<style is:global>
  @layer components {
    .command_wrap {
      --astro-code-foreground: var(--text);
      --astro-code-background: transparent;
      --astro-code-token-function: var(--brand-500);
      --astro-code-token-string: var(--success);
      --astro-code-token-keyword: var(--brand-500);
      --astro-code-token-parameter: var(--text-2);
      --astro-code-token-constant: var(--brand-500);
      --astro-code-token-punctuation: var(--text-2);
      --astro-code-token-comment: var(--text-2);
      position: relative;
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      padding: 0.65rem 0.7rem 0.65rem 1.25rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      background: color-mix(in srgb, var(--background) 52%, transparent);
      backdrop-filter: blur(1.2rem) saturate(1.35);
      box-shadow:
        inset 0 0.0625rem 0 color-mix(in srgb, var(--text) 9%, transparent),
        0 0.75rem 2rem color-mix(in srgb, var(--text) 4%, transparent);
      text-align: left;
      & .command_prompt {
        color: var(--text-2);
        font-family: var(--font-code);
      }
      & .command_source {
        white-space: normal;
        & code {
          display: block;
          white-space: pre;
        }
        flex: 1;
        min-width: 0;
        overflow: auto;
        font: 0.8125rem/1.8 var(--font-code);
        padding-block: 0.25rem;
      }
      & .command_copy {
        position: relative;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        flex-shrink: 0;
        border-color: transparent;
        background: var(--background-2);
        color: var(--text-2);
        &:hover:not(:disabled) {
          background: var(--background-3);
          border-color: transparent;
          color: var(--text);
        }
      }
      & .command_icon {
        position: absolute;
        width: 1.1rem;
        height: 1.1rem;
        inset: 0;
        margin: auto;
        transition:
          opacity 220ms ease,
          transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      & .command_check-icon {
        opacity: 0;
        transform: scale(0.6) rotate(-20deg);
        color: var(--success);
      }
      & .command_copy.copied .command_copy-icon {
        opacity: 0;
        transform: scale(0.6) rotate(20deg);
      }
      & .command_copy.copied .command_check-icon {
        opacity: 1;
        transform: scale(1) rotate(0);
      }
      @media (width < 48rem) {
        gap: 0.5rem;
        padding-left: 0.75rem;
        & .command_source {
          font-size: 0.6875rem;
        }
      }
    }
  }
</style>
