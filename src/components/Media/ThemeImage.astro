---
import Img from "./Img.astro";
type Crop = { x: number; y: number; width: number; height: number };
interface Props {
  /** Set to false to omit the image. */
  render?: boolean;
  /** Default screenshot, also used for dark mode. */
  src: ImageMetadata;
  /** Optional screenshot used when the page is light. */
  light?: ImageMetadata;
  /** Description shared by both theme variants. */
  alt: string;
  /** Source-image bounds to show, in pixels. */
  crop?: Crop;
  /** Light-image bounds; defaults to the full image. */
  cropLight?: Crop;
  /** Load immediately for the main preview. */
  eager?: boolean;
  /** Classes on the image wrapper. */
  class?: string;
}
const {
  render = true,
  src,
  light,
  alt,
  crop,
  cropLight,
  eager = false,
  class: className,
} = Astro.props;
const variants = [
  { image: src, crop, theme: "dark" },
  ...(light ? [{ image: light, crop: cropLight, theme: "light" }] : []),
];
const boundsStyle = (image: ImageMetadata, bounds?: Crop) => {
  const b = bounds ?? { x: 0, y: 0, width: image.width, height: image.height };
  return `--image-ratio:${b.width}/${b.height};--image-width:${(image.width / b.width) * 100}%;--image-left:${(-b.x / b.width) * 100}%;--image-top:${(-b.y / b.height) * 100}%`;
};
---

{
  render && (
    <div class:list={["theme-image_wrap", light && "paired", className]}>
      {variants.map(({ image, crop, theme }) => (
        <div
          class={`theme-image_view ${theme}`}
          style={boundsStyle(image, crop)}
        >
          <Img
            src={image}
            alt={alt}
            loading={eager ? "eager" : "lazy"}
            class="theme-image_asset"
          />
        </div>
      ))}
    </div>
  )
}
<style is:global>
  @layer components {
    .theme-image_wrap {
      width: 100%;
      overflow: hidden;
      border-radius: inherit;
      & .theme-image_view {
        position: relative;
        aspect-ratio: var(--image-ratio);
        overflow: hidden;
      }
      & .theme-image_asset {
        position: absolute;
        width: var(--image-width);
        max-width: none;
        height: auto;
        left: var(--image-left);
        top: var(--image-top);
      }
      & .theme-image_view.light {
        display: none;
      }
      :root:not(.theme-dark) &.paired .theme-image_view.dark {
        display: none;
      }
      :root:not(.theme-dark) &.paired .theme-image_view.light {
        display: block;
      }
    }
  }
</style>
