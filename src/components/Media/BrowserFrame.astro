---
import { slotContent } from "@/utils/slots.ts";
interface Props {
  /** Set to false to omit the frame and its contents. */
  render?: boolean;
  /** Arc is a border only; browser adds glass chrome; Safari uses a compact toolbar. */
  variant?: "arc" | "browser" | "safari";
  /** Decorative address shown when the selected frame includes a toolbar. */
  address?: string;
}
const { render = true, variant = "arc", address = "" } = Astro.props;
const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div class:list={["browser-frame_wrap", variant]}>
      {variant !== "arc" && (
        <div class="browser-frame_toolbar" aria-hidden="true">
          <span class="browser-frame_dots">
            <i />
            <i />
            <i />
          </span>
          <span class="browser-frame_address">{address}</span>
          <span class="browser-frame_action">＋</span>
        </div>
      )}
      <div class="browser-frame_content">
        <Fragment set:html={content} />
      </div>
    </div>
  )
}
<style is:global>
  @layer components {
    .browser-frame_wrap {
      width: 100%;
      padding: 0.7rem;
      border: var(--border-width) solid
        color-mix(in srgb, var(--text) 18%, transparent);
      border-radius: 1.5rem;
      background: color-mix(in srgb, var(--background-2) 55%, transparent);
      backdrop-filter: blur(1.3rem) saturate(1.3);
      box-shadow:
        inset 0 0.0625rem 0 color-mix(in srgb, var(--text) 10%, transparent),
        0 2rem 5rem -0.8rem
          color-mix(in srgb, var(--brand-500) 13%, transparent);
      & .browser-frame_content {
        overflow: hidden;
        border-radius: 0.85rem;
        border: var(--border-width) solid var(--border);
      }
      & .browser-frame_toolbar {
        height: 2.5rem;
        display: grid;
        grid-template-columns: 1fr minmax(0, 40%) 1fr;
        align-items: center;
        gap: 0.75rem;
        padding: 0 0.35rem 0.65rem;
        color: var(--text-2);
      }
      & .browser-frame_dots {
        display: flex;
        gap: 0.35rem;
      }
      & .browser-frame_dots i {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--text-2) 45%, transparent);
      }
      & .browser-frame_address {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: center;
        padding: 0.35rem 0.5rem;
        border-radius: 0.4rem;
        font: 0.65rem var(--font-code);
        background: color-mix(in srgb, var(--background) 60%, transparent);
      }
      & .browser-frame_action {
        justify-self: end;
      }
      &.safari {
        padding: 0.35rem;
        border-radius: 0.9rem;
        & .browser-frame_content {
          border-radius: 0.55rem;
        }
        & .browser-frame_toolbar {
          height: 2rem;
          padding: 0 0.45rem 0.35rem;
        }
        & .browser-frame_dots i:nth-child(1) {
          background: #ff5f57;
        }
        & .browser-frame_dots i:nth-child(2) {
          background: #febc2e;
        }
        & .browser-frame_dots i:nth-child(3) {
          background: #28c840;
        }
      }
      @media (width < 48rem) {
        padding: 0.4rem;
        border-radius: 1rem;
        & .browser-frame_content {
          border-radius: 0.6rem;
        }
        & .browser-frame_toolbar {
          height: 2rem;
          padding-bottom: 0.4rem;
        }
        & .browser-frame_address {
          font-size: 0.5rem;
        }
      }
    }
  }
</style>
