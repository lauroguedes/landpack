---
interface Props {
  /** Enable a soft blur at the bottom of the viewport throughout the page. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <div class="scroll-blur_wrap" aria-hidden="true">
      <>
        <span />
        <span />
        <span />
      </>
    </div>
  )
}
<style is:global>
  @layer components {
    .scroll-blur_wrap {
      position: fixed;
      inset: auto 0 0;
      height: 7rem;
      z-index: 15;
      pointer-events: none;
      & span {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(0.2rem);
        mask-image: linear-gradient(transparent, black);
      }
      & span:nth-child(2) {
        inset: 35% 0 0;
        backdrop-filter: blur(0.4rem);
      }
      & span:nth-child(3) {
        inset: 65% 0 0;
        backdrop-filter: blur(0.7rem);
        background: color-mix(in srgb, var(--background) 15%, transparent);
      }
    }
  }
</style>
