---
import Modal from "@/components/Interactive/Modal.astro";
import GraphicStar from "@/components/Graphic/GraphicStar.astro";
import Button from "@/components/Button.astro";
import GraphicMark from "@/components/Graphic/GraphicMark.astro";
import { getCollection, getEntry } from "astro:content";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Fix the nav over the page rather than letting it stick in flow. */
  overlap?: boolean;
}
const { render = true, overlap = false } = Astro.props;
const entry = await getEntry("project", "main");
if (!entry)
  throw new Error(
    "Add src/content/project/main.yaml to configure the landing page.",
  );
const project = entry.data;
const [features, steps] = await Promise.all([
  getCollection("features"),
  getCollection("steps"),
]);
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <>
          <a class="nav_logo" href="/" aria-label={`${project.name} home`}>
            <>
              <GraphicMark />
              <span>
                {project.shortName}
                <span class="nav_logo_dot">.</span>
              </span>
            </>
          </a>
          <nav class="nav_links" aria-label="Main">
            <>
              <Button
                render={features.length > 0}
                element="link"
                variant="link"
                href="/#features"
              >
                Features
              </Button>
              <Button
                render={steps.length > 0}
                element="link"
                variant="link"
                href="/#get-started"
              >
                Installation
              </Button>
              <Button
                element="link"
                variant="link"
                arrow="up-right"
                href={project.docs}
              >
                Documentation
              </Button>
            </>
          </nav>
          <div class="nav_actions">
            <>
              <button
                class="nav_theme"
                type="button"
                aria-label="Switch to dark theme"
                data-theme-toggle
                hidden
              >
                <svg
                  class="nav_moon"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A8.5 8.5 0 1 0 20.5 14Z" />
                </svg>
                <svg
                  class="nav_sun"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <>
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
                  </>
                </svg>
              </button>
              <Button
                element="link"
                href={project.repository}
                emphasis="secondary"
                class="nav_github"
                aria-label="GitHub"
              >
                <>
                  <GraphicStar />
                  <span>GitHub</span>
                </>
              </Button>
              <button
                class="nav_menu"
                type="button"
                data-modal-open="mobile-navigation"
                aria-label="Open navigation"
                aria-controls="mobile-navigation"
                aria-expanded="false"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
              </button>
            </>
          </div>
        </>
      </div>
      <Modal
        id="mobile-navigation"
        label="Navigation"
        variant="side-panel"
        class="nav_drawer"
      >
        <span class="nav_drawer-title">{project.name}</span>
        <nav class="nav_drawer-links" aria-label="Mobile">
          <Button
            element="link"
            variant="link"
            render={features.length > 0}
            href="/#features"
            data-modal-close
          >
            Features
          </Button>
          <Button
            element="link"
            variant="link"
            render={steps.length > 0}
            href="/#get-started"
            data-modal-close
          >
            Installation
          </Button>
          <Button
            element="link"
            variant="link"
            href={project.docs}
            arrow="up-right"
            data-modal-close
          >
            Documentation
          </Button>
          {project.demo && (
            <Button
              element="link"
              variant="link"
              href={project.demo}
              arrow="up-right"
              data-modal-close
            >
              Demo
            </Button>
          )}
          <Button
            element="link"
            variant="link"
            href={project.repository}
            data-modal-close
          >
            <GraphicStar />
            GitHub
          </Button>
        </nav>
      </Modal>
    </header>
  )
}
<script>
  const header = document.querySelector<HTMLElement>(".nav_wrap");
  if (header) {
    const drawer =
      document.querySelector<HTMLDialogElement>("#mobile-navigation");
    const trigger = header.querySelector<HTMLButtonElement>(".nav_menu");
    let previousY = Math.max(0, window.scrollY);
    let scheduled = false;
    const reveal = () => header.classList.remove("scroll-hidden");
    const updateHeader = () => {
      const y = Math.max(
        0,
        Math.min(
          window.scrollY,
          document.documentElement.scrollHeight - window.innerHeight,
        ),
      );
      header.classList.toggle("scrolled", y > 0);
      if (y <= header.offsetHeight || y < previousY || drawer?.open) reveal();
      else if (y > previousY) header.classList.add("scroll-hidden");
      previousY = y;
      scheduled = false;
    };
    updateHeader();
    window.addEventListener(
      "scroll",
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(updateHeader);
        }
      },
      { passive: true },
    );
    window.addEventListener("pageshow", () => {
      previousY = Math.max(0, window.scrollY);
      updateHeader();
      reveal();
    });
    header.addEventListener("focusin", reveal);
    drawer?.addEventListener("modal-open", () => {
      reveal();
      trigger?.setAttribute("aria-expanded", "true");
    });
    drawer?.addEventListener("modal-close", () => {
      trigger?.setAttribute("aria-expanded", "false");
      previousY = Math.max(0, window.scrollY);
    });
    const desktop = window.matchMedia("(min-width: 48rem)");
    desktop.addEventListener("change", () => {
      if (desktop.matches && drawer?.open) drawer.close();
    });
  }

  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  if (button) {
    button.hidden = false;
    const update = () =>
      button.setAttribute(
        "aria-label",
        document.documentElement.classList.contains("theme-dark")
          ? "Switch to light theme"
          : "Switch to dark theme",
      );
    update();
    button.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("theme-dark");
      document.documentElement.classList.toggle("theme-light", !dark);
      try {
        localStorage.setItem("landpack-theme", dark ? "dark" : "light");
      } catch {}
      update();
    });
  }
</script>
<style is:global>
  @layer components {
    .nav_wrap {
      height: var(--nav-height);
      transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
      &.scroll-hidden {
        transform: translateY(calc(-100% - 1.5rem));
      }
      & .nav_menu {
        display: none;
      }
      position: sticky;
      top: 0;
      z-index: 20;
      background: transparent;
      &.overlap {
        position: fixed;
        width: 100%;
      }
      & .nav_inner {
        width: 100%;
        max-width: none;
        padding-inline: max(
          var(--site-margin),
          calc((100% - var(--max-width-main)) / 2)
        );
        border: var(--border-width) solid transparent;
        border-bottom-color: var(--border);
        background: color-mix(in srgb, var(--background) 94%, transparent);
        backdrop-filter: blur(1rem);
        transition:
          width 380ms ease,
          padding 380ms ease,
          border-radius 380ms ease,
          transform 380ms ease,
          box-shadow 380ms ease;
        margin: auto;
        display: flex;
        align-items: center;
        height: 100%;
        gap: 2rem;
      }
      &.scrolled .nav_inner {
        width: min(calc(100% - 2rem), 74rem);
        padding-inline: 1.5rem;
        border-color: var(--border);
        border-radius: var(--radius-round);
        transform: translateY(0.75rem);
        box-shadow: 0 0.5rem 2rem
          color-mix(in srgb, var(--text) 8%, transparent);
      }
      & .nav_logo {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 1.15rem;
        letter-spacing: -0.04em;
        font-weight: 500;
      }
      & .nav_logo_dot {
        color: var(--brand-500);
      }
      & .nav_links {
        display: flex;
        gap: 1.8rem;
        margin-left: auto;
        font-size: 0.75rem;
      }
      & .nav_links .button_wrap {
        font-size: inherit;
      }
      & .nav_actions {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }
      & .nav_theme {
        width: 2.5rem;
        height: 2.5rem;
        display: grid;
        place-items: center;
        color: var(--text-2);
      }
      & .nav_theme svg {
        grid-area: 1 / 1;
        width: 1.125rem;
        height: 1.125rem;
        transition:
          opacity 220ms ease,
          transform 350ms ease;
      }
      & .nav_sun {
        opacity: 0;
        transform: rotate(-60deg) scale(0.5);
      }
      .theme-dark & .nav_sun {
        opacity: 1;
        transform: rotate(0) scale(1);
      }
      .theme-dark & .nav_moon {
        opacity: 0;
        transform: rotate(60deg) scale(0.5);
      }
      & .nav_theme[hidden] {
        display: none;
      }
      & .nav_github {
        font-size: 0.7rem;
        padding: 0.7rem 0.9rem;
      }
      @media (width < 48rem) {
        & .nav_inner {
          gap: 0.5rem;
          padding-inline: var(--site-margin);
        }
        &.scrolled .nav_inner {
          width: calc(100% - 1rem);
          padding-inline: 1rem;
          border-radius: 2rem;
          transform: translateY(0.5rem);
        }
        & .nav_logo {
          font-size: 1rem;
        }
        & .nav_actions {
          margin-left: auto;
          gap: 0.25rem;
        }
        & .nav_links,
        & .nav_github {
          display: none;
        }
        & .nav_menu {
          display: grid;
          place-items: center;
          width: 2.75rem;
          height: 2.75rem;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        &,
        & .nav_inner {
          transition: none;
        }
      }
    }
    .nav_drawer {
      & .modal_content {
        width: min(23rem, 90vw);
      }
      & .nav_drawer-title {
        display: block;
        font-weight: 600;
        margin-bottom: 2rem;
      }
      & .nav_drawer-links {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: 1.75rem;
      }
      & .nav_drawer-links .button_wrap {
        font-size: 1.1rem;
      }
    }
  }
</style>
