---
import { getCollection, getEntry } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import SectionProjectHero from "@/components/Content/SectionProjectHero.astro";
import ContentProjectStats from "@/components/Content/ContentProjectStats.astro";
import ContentProjectHighlights from "@/components/Content/ContentProjectHighlights.astro";
import ContentProjectFeatures from "@/components/Content/ContentProjectFeatures.astro";
import ContentProjectSetup from "@/components/Content/ContentProjectSetup.astro";
import ContentProjectIntegrations from "@/components/Content/ContentProjectIntegrations.astro";
import ContentProjectFaq from "@/components/Content/ContentProjectFaq.astro";
import SectionProjectCta from "@/components/Content/SectionProjectCta.astro";
const [entry, features, steps, integrations, faq] = await Promise.all([
  getEntry("project", "main"),
  getCollection("features"),
  getCollection("steps"),
  getCollection("integrations"),
  getCollection("faq"),
]);
if (!entry)
  throw new Error(
    "Add src/content/project/main.yaml to configure the landing page.",
  );
const project = entry.data;
const byOrder = (
  a: { data: { order: number } },
  b: { data: { order: number } },
) => a.data.order - b.data.order;
---

<Layout description={project.description}>
  <!-- Hero -->
  <SectionProjectHero project={project} />
  <!-- Project facts -->
  <Section
    render={project.stats.length > 0}
    paddingTop="none"
    paddingBottom="none"><ContentProjectStats stats={project.stats} /></Section
  >
  <!-- Highlights -->
  <Section render={project.highlights.length > 0} id="overview"
    ><ContentProjectHighlights highlights={project.highlights} /></Section
  >
  <!-- Features -->
  <Section render={features.length > 0} id="features" paddingTop="none"
    ><ContentProjectFeatures
      heading={project.featuresHeading}
      description={project.featuresIntro}
      features={features.sort(byOrder)}
    /></Section
  >
  <!-- Installation -->
  <Section render={steps.length > 0} id="get-started" class="project-surface"
    ><ContentProjectSetup
      heading={project.setupHeading}
      description={project.setupIntro}
      note={project.setupNote}
      hasIntegrations={integrations.length > 0}
      steps={steps.sort(byOrder)}
    /></Section
  >
  <!-- Integrations -->
  <Section render={integrations.length > 0} id="connect"
    ><ContentProjectIntegrations
      heading={project.integrationsHeading}
      description={project.integrationsIntro}
      integrations={integrations.sort(byOrder)}
    /></Section
  >
  <!-- Frequently asked questions -->
  <Section render={faq.length > 0} paddingTop="none"
    ><ContentProjectFaq
      heading={project.faqHeading}
      description={project.faqIntro}
      entries={faq.sort(byOrder)}
    /></Section
  >
  <!-- Final call to action -->
  <SectionProjectCta project={project} hasSteps={steps.length > 0} />
</Layout>
